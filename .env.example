# API runtime (load these through your host's environment settings)
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/resumeforge
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Comma-separated Clerk user IDs. Empty means nobody has admin access.
ADMIN_USER_IDS=
# Production: absolute path to the built frontend; Docker sets this automatically.
# STATIC_DIR=/app/artifacts/ats-resume/dist/public
# Optional AI features; the builder and deterministic ATS analysis work without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Existing managed integration (optional alternative to OPENAI_API_KEY)
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Frontend build variables (public; never put secrets in VITE_ variables)
VITE_CLERK_PUBLISHABLE_KEY=
# Leave blank for a standard Clerk application; use only for a configured Clerk proxy.
VITE_CLERK_PROXY_URL=
BASE_PATH=/
# Local Vite development server proxies API requests here.
API_PROXY_TARGET=http://localhost:3001
